# Example only. Put actual values in project .secrets/novelai.env or environment variables.
# A file must include the setting name: NOVELAI_API_KEY=YOUR_ACTUAL_TOKEN
# NOVELAI_API_KEY is a public name; the token on the right is secret.
# novelai_api.py priority: environment -> .secrets/novelai.env -> .secrets/.env -> .env
# Specify only the Persistent API token, without Bearer, email, or password.
# .env.example itself is not loaded. Never write real keys here.
NOVELAI_API_KEY=
# Character prompt variables: use only when requested. Reference as ${NOVELAI_CHAR_MIO} in request JSON.
# novelai_batch.py reads only NOVELAI_CHAR_ variables from .env -> .secrets/novelai.env -> .secrets/.env.
# NOVELAI_CHAR_MIO="1girl, light brown short bob hair, yellow hairclip, yellow hoodie over navy blazer"
# ComfyUI settings below are examples and are not read by novelai_api.py.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ROOT=
