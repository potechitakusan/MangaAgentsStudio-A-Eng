# Example settings for PixAI. Copy to .env.pixai in the project root to use (this example file itself is not read).
# Keep API keys and URLs in the shared .env (or .secrets/pixai.env / environment variables); do not write them in this file.
# pixai_batch.py reads variables from environment variables and .env.pixai. Defining the same name in both raises an error.

# Character, style, background, and LoRA prompt variables (used only when requested). Reference from request JSON as ${VARIABLE_NAME}.
# PIXAI_LORA_ values are LoRA version IDs (the trailing digits in https://pixai.art/model/<modelId>/<versionId>).
# Editing and regeneration guide: docs/pixai-prompts/README.md
# PIXAI_CHAR_MIO="1girl, light brown short bob hair, yellow hairclip, yellow hoodie over navy blazer"
# PIXAI_STYLE_MAIN="clean lineart, soft colors"
# PIXAI_BACKGROUND_CLASSROOM="classroom, desks, windows, daylight"
# PIXAI_LORA_MIO="1234567890123456789"

# Auxiliary settings read by pixai_compose.py (standard request JSON builder) and pixai_batch.py. Aside from the prompt variables above, only these five settings are read.
# Priority: CLI arguments > environment variables / .env.pixai > defaults.
# PIXAI_MODEL="tsubaki2"   # tsubaki3, haruka2, hoshino2, or a version ID
# PIXAI_QUALITY_TAGS="masterpiece, best quality"
# PIXAI_NEGATIVE_PROMPT="text, speech bubble, panel border, watermark"   # These 4 terms are the default when unset; set to empty to omit
# PIXAI_PROMPT_HELPER="disable"
# PIXAI_CHECK_IDENTITY=1
